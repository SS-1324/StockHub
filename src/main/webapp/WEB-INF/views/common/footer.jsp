<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%-- 헤더와 같은 StockHub 로고 파일을 푸터에서도 재사용 --%>
<c:url var="footerLogoUrl" value="/images/StockHub_logo_blue.png" />
<c:url var="footerJsUrl" value="/js/footer.js" />
<c:url var="inquiryUrl" value="/inquiry" />
<c:url var="myInquiriesUrl" value="/inquiry/my" />

<%-- header.jsp에서 연 본문 영역을 닫음 --%>
</main>

<%-- 모든 페이지 아래쪽에 공통으로 표시하는 푸터 --%>
<footer class="site-footer">
    <div class="site-footer-inner">
        <div class="site-footer-main">
            <%-- 푸터 왼쪽에 StockHub 로고를 표시 --%>
            <a class="footer-logo" href="${pageContext.request.contextPath}/"
               aria-label="StockHub 홈으로 이동">
                <img src="${footerLogoUrl}" alt="StockHub">
            </a>

            <%-- 푸터 오른쪽에서 각 모달을 여는 버튼 --%>
            <div class="footer-links">
                <button type="button" class="footer-link-button"
                        data-modal-target="inquiry-modal">문의하기</button>
                <button type="button" class="footer-link-button"
                        data-modal-target="terms-modal">이용약관</button>
                <button type="button" class="footer-link-button"
                        data-modal-target="privacy-modal">개인정보처리방침</button>
            </div>
        </div>

        <%-- 위쪽 구분선을 가진 저작권과 투자 주의 문구 --%>
        <p class="footer-copyright">
            © 2026 StockHub. All rights reserved.
            본 서비스는 투자 권유를 목적으로 하지 않습니다.
        </p>
    </div>
</footer>

<%-- 문의 제목과 내용을 입력하는 모달 --%>
<div id="inquiry-modal"
     class="footer-modal-overlay"
     hidden>
    <section class="footer-modal" role="dialog" aria-modal="true"
             aria-labelledby="inquiry-modal-title">
        <div class="footer-modal-header">
            <h2 id="inquiry-modal-title">문의하기</h2>
            <button type="button" class="footer-modal-close"
                    aria-label="문의하기 창 닫기">×</button>
        </div>

        <form id="inquiry-form" class="inquiry-form"
              action="${inquiryUrl}" method="post">
            <div class="footer-modal-content">
                <div class="inquiry-field">
                    <label for="inquiry-title">제목</label>
                    <input id="inquiry-title" name="title" type="text"
                           maxlength="20" required>
                    <p class="inquiry-count">
                        <span id="inquiry-title-count">0</span>/20
                    </p>
                </div>

                <div class="inquiry-field">
                    <label for="inquiry-content">내용</label>
                    <textarea id="inquiry-content" name="content"
                              maxlength="200" required></textarea>
                    <p class="inquiry-count">
                        <span id="inquiry-content-count">0</span>/200
                    </p>
                </div>
            </div>

            <%-- 문의 등록 버튼을 모달 오른쪽 아래에 배치 --%>
            <div class="inquiry-actions">
                <button class="btn btn-primary"
                        type="submit">문의하기</button>
            </div>
        </form>
    </section>
</div>

<%-- 로그인 회원 본인의 문의와 관리자 답변을 보여주는 모달 --%>
<c:if test="${not empty sessionScope.loginMember}">
    <div id="my-inquiries-modal"
         class="footer-modal-overlay"
         data-list-url="${myInquiriesUrl}"
         hidden>
        <section class="footer-modal my-inquiries-modal"
                 role="dialog" aria-modal="true"
                 aria-labelledby="my-inquiries-modal-title">
            <div class="footer-modal-header">
                <h2 id="my-inquiries-modal-title">내 문의</h2>
                <button type="button" class="footer-modal-close"
                        aria-label="내 문의 창 닫기">×</button>
            </div>

            <%-- 목록은 모달을 열 때 최신 내용으로 불러옴 --%>
            <div id="my-inquiry-list"
                 class="footer-modal-content my-inquiry-list">
                <p class="my-inquiry-message">
                    문의 내역을 불러오는 중입니다.
                </p>
            </div>
        </section>
    </div>
</c:if>

<%-- 이용약관 내용을 보여주는 모달 --%>
<div id="terms-modal" class="footer-modal-overlay" hidden>
    <section class="footer-modal" role="dialog" aria-modal="true"
             aria-labelledby="terms-modal-title">
        <div class="footer-modal-header">
            <h2 id="terms-modal-title">이용약관</h2>
            <button type="button" class="footer-modal-close"
                    aria-label="이용약관 창 닫기">×</button>
        </div>
        <div class="footer-modal-content footer-policy-content">
            <div class="footer-policy-section">
                <p><strong>제1조(목적)</strong></p>
                <p>본 약관은 SH 주식회사(이하 “회사”)가 운영하는 StockHub 웹사이트 및 관련 서비스(이하 “서비스”)의 이용과 관련하여 회사와 이용자 사이의 권리, 의무 및 책임사항을 정하는 것을 목적으로 합니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제2조(용어의 정의)</strong></p>
                <p>1. “서비스”란 회사가 웹사이트를 통해 제공하는 가상 주식 거래, 가상 자산 및 수익률 조회, 랭킹, 주식 정보 및 용어 제공, 커뮤니티, 문의, 회원 관리 등의 기능을 말합니다.</p>
                <p>2. “이용자”란 본 약관에 따라 서비스를 이용하는 회원과 비회원을 말합니다.</p>
                <p>3. “회원”이란 회원가입을 완료하고 아이디와 비밀번호를 이용하여 서비스를 이용하는 자를 말합니다.</p>
                <p>4. “비회원”이란 회원가입 또는 로그인 없이 회사가 허용한 범위의 서비스를 이용하는 자를 말합니다.</p>
                <p>5. “가상 투자”란 실제 금전이나 실제 증권을 사용하지 않고 서비스 안에서 제공되는 가상 자산으로 주식 거래를 체험하는 것을 말합니다.</p>
                <p>6. “게시물”이란 이용자가 커뮤니티 또는 문의 기능을 통해 작성하거나 등록한 글, 이미지, 첨부파일 및 그 밖의 정보를 말합니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제3조(약관의 게시와 변경)</strong></p>
                <p>1. 회사는 이용자가 약관의 내용을 쉽게 확인할 수 있도록 서비스 화면에 게시합니다.</p>
                <p>2. 회사는 관련 법령을 위반하지 않는 범위에서 약관을 변경할 수 있습니다.</p>
                <p>3. 회사는 약관을 변경할 경우 적용일과 변경 사유를 명시하여 적용일 7일 전부터 공지합니다. 다만, 이용자에게 불리하거나 중요한 변경은 적용일 30일 전부터 공지하고 회원이 확인할 수 있는 방법으로 알립니다.</p>
                <p>4. 회원이 변경된 약관의 적용에 동의하지 않는 경우 서비스 이용을 중단하고 회원탈퇴를 할 수 있습니다.</p>
                <p>5. 회사가 변경된 약관의 내용과 적용일을 알리면서 회원이 적용일까지 거부 의사를 표시하지 않으면 동의한 것으로 본다는 사실을 함께 안내하였음에도 회원이 거부 의사를 표시하지 않은 경우, 회원이 변경된 약관에 동의한 것으로 볼 수 있습니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제4조(이용계약의 성립)</strong></p>
                <p>1. 이용계약은 이용자가 본 약관과 개인정보 처리에 필요한 사항에 동의하고 회원가입을 신청한 후 회사가 이를 승인하면 성립합니다.</p>
                <p>2. 회사는 다음의 경우 회원가입 신청을 승인하지 않거나 승인 후 서비스 이용을 제한할 수 있습니다.</p>
                <p>① 타인의 정보를 사용하거나 사실과 다른 정보를 입력한 경우</p>
                <p>② 이미 사용 중인 아이디 또는 닉네임을 사용하려는 경우</p>
                <p>③ 서비스의 정상적인 운영을 방해할 목적으로 신청한 경우</p>
                <p>④ 관련 법령 또는 본 약관을 위반할 우려가 있는 경우</p>
                <p>⑤ 그 밖에 기술적 또는 운영상 승인이 어려운 합리적인 사유가 있는 경우</p>
                <p>3. 회사는 만 14세 미만 아동을 대상으로 회원가입 서비스를 제공하지 않습니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제5조(회원정보의 관리)</strong></p>
                <p>1. 회원은 정확한 정보를 제공해야 하며, 등록한 정보가 변경된 경우 프로필 수정 기능을 이용하여 최신 정보로 변경해야 합니다.</p>
                <p>2. 아이디와 비밀번호의 관리 책임은 회원에게 있습니다.</p>
                <p>3. 회원은 계정이 도용되었거나 제3자가 사용하고 있음을 알게 된 경우 즉시 비밀번호를 변경하고 서비스 내 문의 기능으로 회사에 알려야 합니다.</p>
                <p>4. 회사는 회원의 비밀번호를 원문으로 확인하거나 알려주지 않으며, 이메일 인증을 이용한 비밀번호 재설정 절차를 제공합니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제6조(서비스의 내용)</strong></p>
                <p>회사는 다음의 서비스를 제공합니다.</p>
                <p>1. 회원가입, 로그인, 로그아웃, 이메일 인증, 비밀번호 재설정, 프로필 수정 및 회원탈퇴</p>
                <p>2. 주식 종목 및 시장 관련 정보 제공</p>
                <p>3. 가상 계좌, 가상 잔고, 보유 종목, 거래 내역, 가상 수익금 및 가상 수익률 조회</p>
                <p>4. 가상 주식 매수·매도 등 모의 거래 기능</p>
                <p>5. 가상 투자 결과를 기준으로 한 랭킹 기능</p>
                <p>6. 주식 용어사전 및 용어 도움말 기능</p>
                <p>7. 커뮤니티 게시글 작성·조회·수정·삭제 기능</p>
                <p>8. 이용자 문의 접수 및 답변 확인 기능</p>
                <p>9. 프로필 공개, 내 주식 공개, 화면 모드, 용어 툴팁 등 개인 설정 기능</p>
                <p>10. 그 밖에 회사가 서비스 운영을 위해 추가로 제공하는 기능</p>
                <p>일부 기능은 회원에게만 제공될 수 있으며, 비회원은 회사가 허용한 공개 콘텐츠만 이용할 수 있습니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제7조(가상 투자 서비스의 성격)</strong></p>
                <p>1. StockHub는 교육 및 체험을 위한 가상 투자 서비스이며, 회사는 증권회사, 투자중개업자, 투자자문업자 또는 그 밖의 금융회사가 아닙니다.</p>
                <p>2. 서비스에서 표시되는 계좌, 잔고, 주식, 체결 내역, 수익금 및 수익률은 모두 가상 정보이며 실제 재산상 가치가 없습니다.</p>
                <p>3. 이용자는 서비스의 가상 자산을 현금, 실제 주식, 상품 또는 그 밖의 재산적 가치가 있는 대상으로 교환하거나 출금할 수 없습니다.</p>
                <p>4. 서비스에서 제공하는 종목 정보, 가격, 뉴스, 용어 설명 및 커뮤니티 게시물은 투자 권유나 투자자문을 목적으로 하지 않습니다.</p>
                <p>5. 외부에서 제공받은 시세나 종목 정보는 실제 시장 정보와 다르거나 지연·누락될 수 있습니다. 이용자는 실제 투자 판단에 해당 정보를 단독으로 사용해서는 안 됩니다.</p>
                <p>6. 랭킹과 수익률은 서비스 내부의 가상 데이터와 회사가 정한 산정 방법에 따라 계산되며 실제 투자 성과를 의미하지 않습니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제8조(서비스 이용시간 및 변경)</strong></p>
                <p>1. 서비스는 원칙적으로 연중 이용할 수 있으나 시스템 점검, 장애 대응, 데이터 갱신 또는 운영상 필요한 경우 일부 또는 전부가 일시적으로 중단될 수 있습니다.</p>
                <p>2. 회사는 운영상 또는 기술상 필요한 경우 서비스의 내용, 이용방법 또는 제공시간을 변경할 수 있습니다.</p>
                <p>3. 이용자에게 중대한 영향을 주는 변경이나 예정된 중단은 서비스 공지를 통해 미리 알립니다. 다만, 보안사고나 서버 장애 등 긴급한 사유가 있는 경우 사후에 알릴 수 있습니다.</p>
                <p>4. 교육·포트폴리오용 운영이 종료되는 경우 회사는 합리적인 기간 전에 서비스 종료 사실과 이용자 데이터 처리방법을 공지합니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제9조(랭킹 및 정보 공개)</strong></p>
                <p>1. 랭킹 화면에는 회원의 닉네임, 프로필 이미지, 가상 수익률, 가상 수익금 및 순위 중 서비스 운영에 필요한 항목이 표시될 수 있습니다.</p>
                <p>2. 회원의 보유 종목과 내 주식 상세정보는 회원이 ‘내 주식 공개’ 설정을 활성화한 경우에만 다른 이용자에게 공개합니다.</p>
                <p>3. 회원은 내 주식 공개 설정을 변경할 수 있습니다. 설정을 비공개로 변경하면 새로운 공개는 중단되지만, 변경 전에 다른 이용자가 확인하거나 저장한 정보까지 회수되는 것은 아닙니다.</p>
                <p>4. 데이터 오류, 비정상적인 이용, 시스템 점검 또는 랭킹 산정 방법의 변경이 필요한 경우 회사는 해당 기록을 검토·정정하거나 랭킹에서 일시적으로 제외할 수 있습니다.</p>
            </div>
            <div class="footer-policy-section">
                <p><strong>제10조(게시물의 관리)</strong></p>
                <p>1. 게시물에 대한 권리는 해당 게시물을 작성한 이용자에게 있습니다.</p>
                <p>2. 이용자는 서비스 운영·노출·검색·백업에 필요한 범위에서 회사가 게시물을 이용하는 것을 허락합니다. 이러한 이용은 서비스 제공 목적에 한정됩니다.</p>
                <p>3. 이용자는 다음에 해당하는 게시물을 등록해서는 안 됩니다.</p>
                <p>① 타인의 개인정보, 명예, 저작권 또는 그 밖의 권리를 침해하는 내용</p>
                <p>② 불법행위, 범죄, 사기, 시세조종 또는 허위 투자정보를 조장하는 내용</p>
                <p>③ 욕설, 혐오, 음란물, 반복 광고 또는 서비스 목적과 무관한 내용</p>
                <p>④ 악성코드, 비정상적인 링크 또는 서비스 운영을 방해하는 내용</p>
                <p>⑤ 관련 법령이나 본 약관을 위반하는 내용</p>
                <p>4. 회사는 위 항목에 해당하거나 권리침해 신고가 접수된 게시물을 임시조치, 비공개 또는 삭제할 수 있으며 필요한 경우 작성자의 서비스 이용을 제한할 수 있습니다.</p>
                <p>5. 회원은 필요한 게시물을 회원탈퇴 전에 직접 삭제하거나 서비스 내 문의 기능으로 삭제를 요청할 수 있습니다.</p>
            </div>
            <div class="footer-policy-section">
