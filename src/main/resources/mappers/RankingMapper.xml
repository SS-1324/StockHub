<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.demo.ranking.mapper.RankingMapper">

    <!-- 선택한 기간 안에서 가장 최근에 생성된 랭킹을 조회 -->
    <sql id="rankingDateCondition">
        <choose>
            <when test="period == 'daily'">
                AND rank_date = CURDATE()
            </when>

            <when test="period == 'weekly'">
                AND rank_date &gt;= DATE_SUB(CURDATE(), INTERVAL 6 DAY)
            </when>

            <when test="period == 'yearly'">
                AND rank_date &gt;= MAKEDATE(YEAR(CURDATE()), 1)
            </when>

            <otherwise>
                AND rank_date &gt;= DATE_FORMAT(CURDATE(), '%Y-%m-01')
            </otherwise>
        </choose>
    </sql>

    <!-- 거래 횟수도 선택한 기간에 맞춰 계산 -->
    <sql id="tradeDateCondition">
        <choose>
            <when test="period == 'daily'">
                AND t.trade_at &gt;= CURDATE()
            </when>

            <when test="period == 'weekly'">
                AND t.trade_at &gt;= DATE_SUB(CURDATE(), INTERVAL 6 DAY)
            </when>

            <when test="period == 'yearly'">
                AND t.trade_at &gt;= MAKEDATE(YEAR(CURDATE()), 1)
            </when>

            <otherwise>
                AND t.trade_at &gt;= DATE_FORMAT(CURDATE(), '%Y-%m-01')
            </otherwise>
        </choose>
    </sql>

    <!-- 랭킹 상위 5명을 조회 -->
    <select id="selectRankingBoard"
            resultType="com.kh.demo.ranking.dto.RankingDto">

        SELECT rb.rank_position,
        rb.member_id,
        m.nickname,
        m.profile,
        rb.return_rate,
        COALESCE(tc.trade_count, 0) AS trade_count,
        COALESCE(pp.profit, 0) AS profit

        FROM ranking_board rb

        JOIN members m
        ON m.member_id = rb.member_id

        <!-- 회원별 거래 횟수 -->
        LEFT JOIN (
        SELECT a.member_id,
        COUNT(t.trade_id) AS trade_count

        FROM account a

        JOIN trade t
        ON t.account_id = a.account_id

        WHERE 1 = 1

        <include refid="tradeDateCondition"/>

        GROUP BY a.member_id
        ) tc
        ON tc.member_id = rb.member_id

        <!-- 회원별 현재 평가 수익금 -->
        LEFT JOIN (
        SELECT a.member_id,
        SUM(
        (CAST(s.current_price AS SIGNED)
        - CAST(h.avg_price AS SIGNED))
        * CAST(h.quantity AS SIGNED)
        ) AS profit

        FROM account a

        JOIN holding h
        ON h.account_id = a.account_id

        JOIN stock s
        ON s.stock_code = h.stock_code

        GROUP BY a.member_id
        ) pp
        ON pp.member_id = rb.member_id

        WHERE rb.stock_code IS NULL

        AND rb.rank_date = (
        SELECT MAX(rank_date)

        FROM ranking_board

        WHERE stock_code IS NULL

        <include refid="rankingDateCondition"/>
        )

        ORDER BY rb.rank_position ASC

        LIMIT 5

    </select>

</mapper>