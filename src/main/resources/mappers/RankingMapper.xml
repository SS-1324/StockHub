<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.demo.ranking.mapper.RankingMapper">

    <select id="selectRankingBoard" resultType="com.kh.demo.ranking.dto.RankingDto">
        SELECT member_id, nickname
        FROM member
        ORDER BY member_id
        LIMIT 10
    </select>

</mapper>